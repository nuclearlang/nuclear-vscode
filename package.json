  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "theme": "node theme/build.mjs && node theme/icons.mjs",
    "server": "node scripts/bundle-server.mjs",
    "package": "npm run theme && npm run compile && npm run server && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "^0.24.1",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nuclearlang/nuclear-vscode.git"
  },
  "homepage": "https://nuclearlang.github.io",
  "bugs": {
    "url": "https://github.com/nuclearlang/nuclear-vscode/issues"
  }
}
