          },
          "nuclear.codemetrics.basics.ComplexityLevelHigh": {
            "default": 10,
            "description": "Threshold to determine high complexity level",
            "type": "number"
          },
          "nuclear.codemetrics.basics.ComplexityLevelHighDescription": {
            "default": "You must be kidding",
            "description": "Code lens message for high complexity level",
            "type": "string"
          },
          "nuclear.codemetrics.basics.ComplexityLevelLow": {
            "default": 0,
