{
  "name": "nuclearlang",
  "displayName": "NuclearLang",
  "description": "NuclearLang (.nuc) support: the Nuclear workspace (projects as tabs, tools full screen, keyboard first), language server, semantic highlighting, code metrics, the Dragonfly dialects (flutter, fastapi, nestjs, react) and the Chernobyl theme",
  "version": "0.37.2",
  "publisher": "nuclearlang",
  "license": "Apache-2.0",
  "icon": "icons/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Linters"
  ],
  "keywords": [
    "nuclear",
    "nuc",
    "flutter",
    "dart",
    "transpiler",
    "lsp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:nuclear",
    "workspaceContains:**/*.nuc",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nuclear",
        "aliases": [
          "NuclearLang",
          "Nuclear",
          "nuc"
        ],
        "extensions": [
          ".nuc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nuc-file.svg",
          "dark": "./icons/nuc-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nuclear",
        "scopeName": "source.nuclear",
        "path": "./syntaxes/nuclear.tmLanguage.json"
      },
      {
        "scopeName": "source.nuclear.example",
        "path": "./syntaxes/nuclear-example.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Chernobyl",
        "uiTheme": "vs-dark",
        "path": "./themes/chernobyl-color-theme.json"
      },
      {
        "label": "Chernobyl Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/chernobyl-soft-color-theme.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "kind",
        "description": "A dialect kind in a declaration header (stateless, stateful, extension...)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "nuclear",
        "scopes": {
          "keyword.kind": [
            "storage.type.kind.nuclear"
          ],
          "class.defaultLibrary": [
            "support.class.nuclear"
          ],
          "function.defaultLibrary": [
            "support.function.nuclear"
          ]
        }
      }
    ],
    "configuration": [
      {
        "title": "NuclearLang",
        "properties": {
          "nuclear.dialect": {
            "type": "string",
            "default": "flutter",
            "enum": [
              "flutter",
              "fastapi",
              "nestjs",
              "react",
              "dart",
              "python",
              "typescript",
              "base"
            ],
            "enumDescriptions": [
              "Dragonfly mobile: Flutter widgets, Dart output",
              "Dragonfly backend: FastAPI, Python output",
              "Dragonfly backend: NestJS, TypeScript output",
              "Dragonfly web: React, TypeScript output",
              "Dart language only",
              "Python language only",
              "TypeScript language only",
              "Only the base language (syntax and reserved words), without a dialect"
            ],
            "markdownDescription": "Dialect used to check `.nuc` files outside a project. A project names its platform and dialect in `config.nuc` (or `nuclear.toml`) and the server uses those. `base` checks only the base language.",
            "scope": "resource"
          },
          "nuclear.dialectPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Extra directories with dialects (absolute or relative to the workspace). `<workspace>/dialects` is always searched.",
            "scope": "resource"
          },
          "nuclear.server.path": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the `nuclear-lsp` binary. Empty: the one bundled with the extension, then `nuclear-lsp` on the `PATH`."
          },
          "nuclear.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Traces the communication between VS Code and the Nuclear language server."
          },
          "nuclear.debug.followInNuclear": {
            "type": "boolean",
            "default": true,
            "description": "When a Dragonfly app pauses (breakpoint, step, exception), show and highlight the .nuc line of the paused code."
          },
          "nuclear.debug.explainErrors": {
            "type": "boolean",
            "default": true,
            "description": "Show Dart run-time errors of a Dragonfly app at their .nuc line (Problems panel) with a panel beside that explains the error, the Nuclear call stack and the original Dart error."
          },
          "nuclear.workspace.welcome": {
            "type": "boolean",
            "default": true,
            "description": "Show the Nuclear workspace welcome page (projects and shortcuts) when VS Code starts with no editor open. Ctrl+Alt+W opens it any time."
          },
          "nuclear.buildOnSave": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Saving a `.nuc` of a backend or web project runs `dragonfly build`: the running server or page reloads by itself (uvicorn `--reload`, `node --watch`, Vite). Mobile projects hot reload on save through the Flutter session."
          }
        }
      },
      {
