    "menus": {
      "editor/title/run": [],
      "editor/title": [
        {
          "command": "nuclear.showGeneratedCode",
          "when": "editorLangId == nuclear",
          "group": "navigation"
        },
        {
          "command": "nuclear.action.run",
          "when": "nuclear.platform == mobile",
          "group": "navigation@0"
        },
        {
          "command": "nuclear.action.serve",
          "when": "nuclear.platform =~ /^(backend|web)$/",
          "group": "navigation@1"
        },
        {
          "command": "nuclear.action.debug",
          "when": "nuclear.platform =~ /^(mobile|backend|web)$/",
          "group": "navigation@2"
        },
        {
          "command": "nuclear.action.reload",
          "when": "nuclear.platform =~ /^(mobile|web)$/",
          "group": "navigation@3"
        },
        {
          "command": "nuclear.action.device",
          "when": "nuclear.platform =~ /^(mobile|web)$/",
          "group": "navigation@4"
        },
        {
          "command": "nuclear.action.build",
          "when": "nuclear.platform =~ /^(mobile|backend|web)$/",
          "group": "navigation@5"
        },
        {
          "command": "nuclear.action.test",
          "when": "nuclear.platform =~ /^(mobile|backend|web)$/",
          "group": "navigation@6"
        },
        {
          "command": "nuclear.action.check",
          "when": "nuclear.platform =~ /^(mobile|backend|web)$/",
          "group": "navigation@7"
        },
        {
          "command": "nuclear.action.api",
          "when": "nuclear.platform == backend",
          "group": "navigation@8"
        }
      ],
      "commandPalette": [
        {
          "command": "nuclear.run",
          "when": "nuclear.canRun"
        },
        {
          "command": "nuclear.debug",
          "when": "nuclear.canRun"
        },
        {
          "command": "nuclear.showGeneratedCode",
          "when": "editorLangId == nuclear"
        },
        {
          "command": "nuclear.showCodeMetricsCodeLensInfo",
          "when": "false"
        },
        {
          "command": "nuclear.debug.stepOver",
          "when": "nuclear.pausedInNuc"
        },
        {
          "command": "nuclear.debug.stepInto",
          "when": "nuclear.pausedInNuc"
        },
        {
          "command": "nuclear.debug.stepOut",
          "when": "nuclear.pausedInNuc"
        },
        {
          "command": "nuclear.debug.openPlace",
          "when": "false"
        }
      ],
      "debug/toolBar": [
        {
          "command": "nuclear.debug.stepOver",
          "when": "nuclear.pausedInNuc",
          "group": "navigation@11"
        }
      ],
      "editor/context": [
        {
          "command": "nuclear.debug.otherSide",
          "when": "inDebugMode && (resourceExtname == .nuc || resourceExtname == .dart)",
          "group": "navigation@0"
        }
      ]
    },
