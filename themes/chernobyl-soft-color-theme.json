    },
    {
      "name": "throw",
      "scope": [
        "keyword.control.throw",
        "keyword.control.exception.throw"
      ],
      "settings": {
        "foreground": "#FFAA00",
        "fontStyle": ""
      }
    },
    {
      "name": "nullValue",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nil"
