  "tokenColors": [
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#ECECEC",
        "fontStyle": ""
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#00E5FF",
        "fontStyle": ""
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FF6AC1",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "keyword.operator.word",
        "keyword.operator.logical.word"
      ],
      "settings": {
        "foreground": "#FFAA00",
        "fontStyle": ""
      }
    },
    {
      "name": "kind",
      "scope": [
        "storage.type.kind"
      ],
      "settings": {
        "foreground": "#FFAA00",
        "fontStyle": ""
      }
    },
    {
      "name": "modifier",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFAA00",
        "fontStyle": ""
      }
    },
    {
      "name": "selfKeyword",
      "scope": [
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#FFAA00",
        "fontStyle": ""
