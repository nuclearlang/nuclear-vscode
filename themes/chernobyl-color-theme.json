  "tokenColors": [
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8A9A8A",
        "fontStyle": ""
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#8FD400",
        "fontStyle": ""
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D9E4D2",
        "fontStyle": ""
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "keyword.operator.word",
        "keyword.operator.logical.word"
      ],
      "settings": {
        "foreground": "#A7FF00",
        "fontStyle": ""
